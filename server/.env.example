# Copy to .env and adjust. The server validates these at boot and exits with a
# readable message if any are missing or malformed — see src/config/env.ts

NODE_ENV=development
PORT=4000

# Local Homebrew Postgres uses your macOS username and no password:
#   postgresql://$(whoami)@localhost:5432/client_requests
# The bundled docker-compose.yml instead exposes:
#   postgresql://postgres:postgres@localhost:5433/client_requests
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/client_requests

# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# Signing secret for the demo session tokens. Any non-empty string works locally;
# in a real deployment this would be a managed secret and tokens would be real JWTs.
AUTH_SECRET=dev-only-secret-change-me

# Credentials for the seeded demo account.
DEMO_USER_EMAIL=ops@example.com
DEMO_USER_PASSWORD=demo1234

# Mounts POST /api/v1/demo/reset (rate limited to 3/min) and shows the matching
# palette command, so a public demo survives the first visitor who marks everything
# done. Off by default: the endpoint does not exist in a normal deployment.
DEMO_MODE=false
